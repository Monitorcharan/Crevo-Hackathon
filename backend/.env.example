# Local mode works without these values. Set all three for real Supabase mode.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only. Never add this to a VITE_ variable or frontend .env.
SUPABASE_SECRET_KEY=
# Set a long random value before using local mode outside your own machine.
LOCAL_JWT_SECRET=replace-me-for-any-shared-environment
# Optional real AI generation. Gemini takes priority when both keys are set.
# Free tier limits and data-use terms depend on your Google AI Studio plan.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Firebase web config is public, but configure it on the backend at runtime.
# Enable only providers actually configured in Firebase Console.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_AUTH_PROVIDERS=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
